{
  "$schema": "./projects.schema.json",
  "projects": {
    "example-app": {
      "defaultMachine": "worker-machine",
      "baseBranch": "main",
      "repo": "your-org/example-app",
      "useWorktree": false,
      "reviewer": {
        "enabled": true,
        "agent": "pi",
        "model": "openai-codex/gpt-5.4",
        "effort": "high"
      },
      "paths": {
        "worker-machine": "/Users/you/projects/example-app",
        "main-machine": "/home/agent/projects/example-app"
      }
    },
    "bordr-swarm": {
      "defaultMachine": "worker-machine",
      "baseBranch": "main",
      "repo": "kodi/bordr-swarm",
      "useWorktree": false,
      "paths": {
        "worker-machine": "/Users/you/projects/bordr-swarm",
        "main-machine": "/home/agent/projects/bordr-swarm"
      }
    }
  }
}
