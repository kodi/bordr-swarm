{
  "name": "bordr-swarm",
  "version": "0.1.0",
  "private": true,
  "description": "Reproducible setup and TypeScript orchestration for a Vercel Board + Herdr + Sheprd agent swarm",
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "doctor": "node scripts/doctor.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check": "npm run fmt:check && npm run lint && npm run typecheck && npm run test",
    "test": "node --test tests/*.test.ts",
    "schemas:generate": "node scripts/generate-schemas.ts",
    "dispatcher": "node src/dispatcher.ts",
    "apply:main": "node scripts/apply-main.ts",
    "apply:worker": "node scripts/apply-worker.ts"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "lefthook": "^2.2.4",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
